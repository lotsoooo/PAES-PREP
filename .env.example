# ============================================================================
# PAES Pro — variables de entorno
# Copia a .env y ajusta. NUNCA subas .env al repositorio.
# ============================================================================

# --- Base de datos ----------------------------------------------------------
DATABASE_URL=postgres://paes:paes_local_dev@localhost:5432/paes_pro
# Neon/Supabase usan el pooler; en desarrollo local usa el puerto directo.
# DATABASE_URL=postgresql://USER:PASS@ep-xxx-pooler.neon.tech/paes_pro?sslmode=require

# --- API --------------------------------------------------------------------
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173

# Secretos: genera con `openssl rand -base64 48`
JWT_SECRET=cambia-esto-por-un-secreto-aleatorio-de-al-menos-32-caracteres
REFRESH_SECRET=cambia-esto-por-otro-secreto-aleatorio-distinto-de-32-chars
ACCESS_TOKEN_TTL_MIN=15

# --- Frontend (Vite) --------------------------------------------------------
VITE_API_URL=http://localhost:3000/api/v1

# --- Login con Google (OAuth2 / PKCE) ---------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# --- Almacenamiento S3-compatible (Supabase Storage / Cloudflare R2) --------
# Si se dejan vacíos, el API usa la carpeta local ./uploads
STORAGE_DRIVER=local
STORAGE_BUCKET=paes-pro
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=
STORAGE_LOCAL_DIR=uploads

# --- Pagos (Transbank Webpay Plus) -----------------------------------------
# El API nunca recibe datos de tarjeta: se paga en la página de Webpay.
# mock    → sandbox simulado de la propia app (solo fuera de producción y con
#           PAYMENT_SANDBOX_ENABLED=true). Activa Premium solo en ese entorno.
# webpay  → Transbank. Sin TRANSBANK_API_KEY/SECRET los pagos quedan
#           deshabilitados (no hay simulador de respaldo).
# Cobros reales: NODE_ENV=production + TRANSBANK_INTEGRATION_TYPE=production
#                + PAYMENT_LIVE_ENABLED=true.
PAYMENT_PROVIDER=mock
PAYMENT_SANDBOX_ENABLED=true
PAYMENT_LIVE_ENABLED=false
PREMIUM_TRIAL_DAYS=7
# URL pública del API: Webpay vuelve a /api/v1/premium/webpay/retorno.
API_PUBLIC_URL=http://localhost:3000
TRANSBANK_INTEGRATION_TYPE=integration
TRANSBANK_API_KEY=
TRANSBANK_API_SECRET=

# --- Mailer (recuperación de contraseña) ------------------------------------
# Requiere SMTP configurado. Sin él la recuperación queda no disponible.
# Los enlaces y tokens de recuperación nunca se escriben en logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=PAES Pro <no-reply@paespro.cl>
APP_URL=http://localhost:5173

# --- Docker -----------------------------------------------------------------
VITE_API_URL_DOCKER=http://localhost:3000/api/v1

# --- Tutor IA "PAES-Bot" (Premium) -------------------------------------------
# El servicio real requiere permiso explícito, clave y modelo configurado.
# Sin ellos se identifica como demostración basada en los materiales.
AI_PAID_ENABLED=false
AI_MAX_OUTPUT_TOKENS=2048
AI_REQUESTS_PER_DAY=30
# ANTHROPIC_MODEL=
# ANTHROPIC_API_KEY=
