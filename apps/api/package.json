{
  "name": "@paes-pro/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build --target=bun --outdir=dist src/index.ts",
    "start": "bun run dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "db:reset": "bun run src/db/reset.ts",
    "db:seed": "bun run src/db/seed.ts",
    "db:pull": "bun run src/db/pull.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.716.0",
    "@aws-sdk/s3-request-presigner": "^3.716.0",
    "@hono/node-server": "^1.13.7",
    "@hono/zod-openapi": "^0.19.4",
    "@hono/zod-validator": "^0.4.1",
    "@paes-pro/shared": "workspace:*",
    "drizzle-orm": "^0.38.3",
    "hono": "^4.6.14",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.1"
  }
}
